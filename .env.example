# 公网域名，DNS A/AAAA 记录需先指向 VPS
DOMAIN=scheduler.example.com
# 使用仅含字母和数字的长随机密码，避免 DATABASE_URL 特殊字符转义问题
MYSQL_PASSWORD=ReplaceWithAtLeast24RandomChars
# 三个初始账户的首次密码；登录后请立即通过“账户权限”分别重置
BOOTSTRAP_PASSWORD=ReplaceWithAtLeast16RandomChars
# 总经理 guoxuan 的首次密码；登录后请立即重置
GUOXUAN_BOOTSTRAP_PASSWORD=ReplaceWithAtLeast16RandomChars
# 排产基准日使用的本地时区，可按工厂所在地调整
TZ=Asia/Shanghai
